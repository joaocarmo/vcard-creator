{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "esnext",
    "types": ["vitest/globals", "node"]
  },
  "include": ["lib/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest*.ts"],
  "exclude": ["node_modules", "dist/**/*", "test/functional"]
}
