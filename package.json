{
  "name": "vcard-creator",
  "version": "1.0.0",
  "type": "module",
  "description": "A JavaScript vCard 3.0 creator library for both node.js and the web",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:lib": "tsc -p tsconfig.build.json",
    "build": "pnpm clean && pnpm build:lib",
    "clean": "rimraf ./dist/ ./node_modules/.cache/",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepare": "husky",
    "pretty:fix": "prettier --write .",
    "pretty": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:functional": "tsc -p test/functional && vitest run --config vitest.functional.config.ts",
    "test:smoke": "node test/smoke/node.mjs",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit",
    "version:set": "node scripts/sync-version.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaocarmo/vcard-creator.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "keywords": [
    "vcard",
    "node",
    "browser"
  ],
  "author": "Joao Carmo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joaocarmo/vcard-creator/issues"
  },
  "homepage": "https://github.com/joaocarmo/vcard-creator#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
