{
  "name": "vcard-creator",
  "version": "0.0.0-development",
  "type": "module",
  "description": "A JavaScript vCard 3.0 creator library for both node.js and the web",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:lib": "tsc -p tsconfig.build.json",
    "build": "pnpm clean && pnpm build:lib",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepare": "husky",
    "pretty:fix": "prettier --write .",
    "pretty": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:functional": "tsc -p test/functional && vitest run --config vitest.functional.config.ts",
    "test:smoke": "node test/smoke/node.mjs",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit",
    "version:set": "node scripts/set-version.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaocarmo/vcard-creator.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "vcard",
    "node",
    "browser"
  ],
  "author": "Joao Carmo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joaocarmo/vcard-creator/issues"
  },
  "homepage": "https://github.com/joaocarmo/vcard-creator#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
